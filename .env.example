# Q-SHIELD gateway configuration. Copy to .env. Variable names and safe defaults only.
# Never commit .env, keys, or real credentials.

# --- Gateway ---
# 0.0.0.0 lets a device on the LAN reach the gateway. Use 127.0.0.1 for local-only runs.
QSHIELD_HOST=0.0.0.0
QSHIELD_PORT=8000
DATABASE_URL=sqlite:///./qshield.db
# Seconds without an authenticated message before a device is reported OFFLINE.
DEVICE_OFFLINE_TIMEOUT_S=15

# --- Device discovery / registration ---
# There is deliberately no fixed device IP. Devices are device-initiated: each device
# is configured (firmware secrets.h) with the gateway hostname/IP and POSTs /api/v1/register
# and heartbeats; the gateway learns the device from those authenticated messages.
# Because the laptop's own address can also change under DHCP, prefer a hostname
# (e.g. <laptop-hostname>.local via mDNS, or a fixed DHCP reservation) in the firmware config.

# --- Gateway secrets (all optional: if unset, generated under KEYS_DIR on first start) ---
# Master key encrypting device HMAC secrets at rest: 64 hex chars. Losing it means re-provisioning devices.
QSHIELD_MASTER_KEY_HEX=
# Bearer tokens (>= 32 chars). operator: read/control APIs. ingest: local vision service only.
QSHIELD_OPERATOR_TOKEN=
QSHIELD_INGEST_TOKEN=

# --- Device authentication (ESP32 profile) ---
# Provisioned per-device HMAC-SHA256 secrets are created by scripts/enroll_device.py and
# stored under keys/ (gitignored). This is symmetric authentication; it is NOT post-quantum.

# --- PQC gateway security (laptop side) ---
PQC_ENABLED=true
# Key establishment: ML-KEM-768. Signatures: ML-DSA-65.
PQC_KEM_ALGORITHM=ML-KEM-768
PQC_SIG_ALGORITHM=ML-DSA-65
# Private keys are sealed under subkeys of the master key (QSHIELD_MASTER_KEY_HEX / keys/master.key).
# Gateway KEM key ids (comma-separated, first is active), created by scripts/pqc_provision.py init-gateway.
PQC_GATEWAY_KEM_KEY_IDS=gateway-kem-1
# Accepted clock skew for signed observations / handshakes (seconds) and session lifetime.
PQC_MAX_SKEW_S=300
PQC_SESSION_TTL_S=3600
# true = reject the token-only (non-PQC) observation endpoint.
REQUIRE_SIGNED_OBSERVATIONS=false
# Vision service only: its own key-encryption key (or keys/pqc/<signer>.kek). NOT the master key.
QSHIELD_SIGNER_KEK_HEX=
KEYS_DIR=keys

# --- AI/ML model paths (weights are downloaded locally, never committed) ---
VISION_MODEL_PATH=ai/models/vision.pt
ANOMALY_MODEL_PATH=ai/models/anomaly.pkl
CAMERA_INDEX=0

# --- Evidence ---
EVIDENCE_LOG_DIR=evidence/runtime/

# Trust engine (Phase 4)
TRUST_ENABLED=true
# TRUST_CONFIG_PATH=config/trust.json   # only sensor_limits, expected_fw_version, expected_cfg_hash, offline_timeout_s
